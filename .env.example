# Copy to .env and fill in. Never commit .env.

# ---- LLM (any OpenAI-compatible endpoint) ----
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=your-model

# ---- X / Twitter (only if you use the custom X collector) ----
# Extract from a logged-in browser: DevTools -> Application -> Cookies -> x.com
X_AUTH_TOKEN=
X_CT0_TOKEN=

# ---- optional proxy ----
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# ---- MediaCrawler runtime ----
# Path to a Python interpreter that can run MediaCrawler.
# Leave empty to let setup.sh create vendors/MediaCrawler/.venv
MEDIACRAWLER_PYTHON=
